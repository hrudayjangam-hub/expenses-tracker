PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/expenses_tracker
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development

