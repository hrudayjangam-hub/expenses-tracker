PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/expenses_tracker
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Production (Vercel):
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/expenses_tracker
# CLIENT_URL=https://your-app.vercel.app
# NODE_ENV=production
# JWT_SECRET=<long random string>
# (PORT is ignored on Vercel)

# Email budget alerts (optional — alerts are skipped when unset).
# Use a Gmail app password or any SMTP provider:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=you@gmail.com
