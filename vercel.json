{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd backend && npm ci && cd ../frontend && npm ci",
  "buildCommand": "cd frontend && node node_modules/vite/bin/vite.js build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    }
  ]
}
